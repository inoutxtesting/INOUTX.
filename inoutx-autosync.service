[Unit]
Description=IN/OUT X Git Auto-Sync Poller Daemon (Vercel-style deployment)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/iqac2/Documents/INOUTX-FINAL/INOUTX.
ExecStart=/home/iqac2/Documents/INOUTX/venv313/bin/python3 /home/iqac2/Documents/INOUTX-FINAL/INOUTX./auto_sync_daemon.py
Restart=always
RestartSec=10
Environment=DISPLAY=:0
Environment=PYTHONUNBUFFERED=1

[Install]
