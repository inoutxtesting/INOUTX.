[Unit]
Description=IN/OUT X Flask Server Application
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=iqac2
WorkingDirectory=/home/iqac2/Documents/INOUTX/Frontend
ExecStart=/home/iqac2/Documents/INOUTX/venv313/bin/python3 /home/iqac2/Documents/INOUTX/Frontend/app.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
