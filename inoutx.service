[Unit]
Description=IN/OUT X Flask Server Application
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=iqac2
WorkingDirectory=/home/iqac2/Documents/INOUTX-FINAL/INOUTX.
ExecStart=/home/iqac2/Documents/INOUTX-FINAL/INOUTX./venv313/bin/gunicorn --worker-class gthread --workers 1 --threads 50 --bind 0.0.0.0:5000 --access-logfile - --error-logfile - --timeout 120 Frontend.app:app
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
