# PostgreSQL connection string from your managed database provider.
# Remote database connections use TLS. Keep the real URL in deployment secrets.
DATABASE_URL=postgresql://inoutx_user:replace_me@db.example.com:5432/inoutx
POSTGRES_POOL_SIZE=20
SECRET_KEY=replace_with_a_long_random_secret
APP_BASE_URL=https://inoutx.example.com
# Comma-separated browser origins; defaults to APP_BASE_URL.
CORS_ORIGINS=https://inoutx.example.com

# Camera RTSP URLs (Credentials should stay in local .env, never commit real passwords)
KRCT_RTSP_URL=rtsp://username:password@192.168.0.141:554/Streaming/channels/101
KRCE_RTSP_URL=rtsp://username:password@192.168.0.77:554/Streaming/channels/101

# Authorized college email domains
COLLEGE_EMAIL_DOMAINS=krct.ac.in,krce.ac.in

# SMTP used to send college email verification codes.
# For Gmail, use an App Password for MAIL_PASSWORD.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-college-email@krct.ac.in
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=your-college-email@krct.ac.in
